#version 450
in vec3 frag_pos;
in vec3 frag_normal;
in vec2 tex_coord;

layout(binding = 0) uniform uniforms {
  mat4 model;
  mat4 view;
  mat4 proj;
  vec4 light_pos;
  vec4 light_color_intensity;
  vec4 tex_offset_scale;
};
// TODO: textures
// uniform sampler2D atlas;

out vec4 FragColor;


void main(){
  vec2 tex_scale = tex_offset_scale.zw;
  vec2 tex_offset = tex_offset_scale.xy;
  vec2 atlas_uv = tex_coord * tex_scale + tex_offset;

  vec3 light_pos = light_pos.xyz;
  vec3 light_color = light_color_intensity.rgb;
  float light_intensity = light_color_intensity.a;
  // vec4 color = texture(atlas, atlas_uv);
  vec4 color = vec4(1.0, 0.0, 0.0, 1.0);
  vec3 N = normalize(frag_normal);
  vec3 L = normalize(light_pos - frag_pos);
  float diffuse = max(dot(N, L), 0.0);
  float ambient = 0.2;
  vec3 lighting = light_color * (ambient + light_intensity * diffuse);
  FragColor = vec4(color.rgb * lighting, color.a);
// "FragColor = color;"
}
